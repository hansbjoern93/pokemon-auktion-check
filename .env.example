# Kopieren nach .env und ausfüllen. Die .env wird nie eingecheckt.

# --- Schritt 1: Kartendatenbank (TCGdex, kein Schlüssel nötig) ---
# Sprachen für Namen/Attacken (kommagetrennt). Leer = alle von TCGdex unterstützten.
TCGDEX_SPRACHEN=
# Gleichzeitige Abrufe bei TCGdex (bitte fair bleiben, 8 ist ein guter Wert)
TCGDEX_PARALLEL=8
# Speicherort der Datenbank (Standard: data/karten.sqlite)
# DB_PFAD=data/karten.sqlite

# --- Schritt 2: Erkennung mit Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODELL=claude-opus-5-5

# --- Schritt 3: eBay Browse API (Production-Keyset) ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
