# Kopieren nach .env und ausfüllen. Die .env wird nie eingecheckt.

# --- Schritt 1: Kartendatenbank (TCGdex, kein Schlüssel nötig) ---
# Sprachen für Namen/Attacken (kommagetrennt). Leer = alle von TCGdex unterstützten.
TCGDEX_SPRACHEN=
# Gleichzeitige Abrufe bei TCGdex (bitte fair bleiben, 8 ist ein guter Wert)
TCGDEX_PARALLEL=8
# Speicherort der Datenbank (Standard: data/karten.sqlite)
# DB_PFAD=data/karten.sqlite

# --- Schritt 2: Erkennung ---
# Grundsätzlich lokal und kostenlos (Texterkennung + Bildvergleich).
# Optional liest Claude unsichere Karten nach, über das installierte Claude Code (dein Abo,
# kein API-Schlüssel, keine Zusatzkosten; zählt zum Abo-Kontingent).
#   aus      = nur lokal
#   unsicher = Claude nur für unsichere Karten und teure Versionsfragen (empfohlen)
#   immer    = Claude für jede Karte (verbraucht viel Kontingent)
ERKENNUNG_CLAUDE=aus
# Modell für Claude Code: sonnet (schont das Kontingent), opus oder ein voller Modellname
CLAUDE_MODELL=sonnet
# Befehl, unter dem Claude Code installiert ist
CLAUDE_CODE_BEFEHL=claude

# --- Schritt 3: eBay Browse API (Production-Keyset) ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
